# Copy this file to `.env` and fill in the values. `.env` is git-ignored
# and must never be committed or submitted.

# JSON-RPC endpoint for the Sepolia testnet (free tier of Alchemy/Infura is fine),
# e.g. https://eth-sepolia.g.alchemy.com/v2/<your-key>
SEPOLIA_RPC_URL=

# 12-word test mnemonic. Five role accounts are derived from it:
#   index 0 = admin + regulator (deployer; fund this one from a Sepolia faucet)
#   index 1 = manufacturer, 2 = distributor, 3 = pharmacy, 4 = oracle node
# Generate a fresh one with: npx hardhat run scripts/new-wallet.js
# NEVER reuse a mnemonic that holds real funds.
MNEMONIC=

# Set to "true" to print a gas usage report when running tests
REPORT_GAS=
